# Copy this file to .env to override defaults (optional — docker compose works without it).

# Database
POSTGRES_USER=taskalign
POSTGRES_PASSWORD=taskalign_password
POSTGRES_DB=taskalign
POSTGRES_PORT=5432

# App ports (host side)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Base URL the browser uses to reach the backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
